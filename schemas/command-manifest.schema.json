{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecc-fusion.local/schemas/command-manifest.schema.json",
  "title": "ECC-Fusion Command Manifest",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "command",
      "file",
      "category",
      "pathAvailability",
      "stateRequired",
      "transitionNoticeBehavior",
      "sourceInspiration",
      "relatedSkill"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "command": { "type": "string", "pattern": "^/[a-z0-9-]+$" },
      "file": { "type": "string", "minLength": 1 },
      "category": {
        "type": "string",
        "enum": [
          "Discovery & Help",
          "Clarification & Research",
          "Specification & Product",
          "Architecture & Planning",
          "Work Packet & Delegation",
          "Implementation",
          "Testing & Verification",
          "Review & Security",
          "QA & Release",
          "Documentation & Handoff",
          "Memory & Context Management",
          "Governance & Maintenance",
          "Automation Accelerators"
        ]
      },
      "pathAvailability": {
        "type": "array",
        "items": { "enum": ["Short Path", "Regular Path", "Auto", "Ralph"] },
        "minItems": 1,
        "uniqueItems": true
      },
      "stateRequired": { "type": "boolean" },
      "transitionNoticeBehavior": { "type": "string", "minLength": 1 },
      "sourceInspiration": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
      "relatedSkill": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": false
  }
}
