    "rules": [
      "global-engineering-rules",
      "context-management-rules",
      "skill-governance-rules",
      "path-switching-rules",
      "testing-rules",
      "security-rules",
      "dependency-rules",
      "oss-worker-rules",
      "high-end-reviewer-rules",
      "ralph-safety-rules"
    ]
  },
  "kiroPlanningArtifacts": {
    "root": ".planning/specs/<feature-slug>/",
    "requirements": "requirements.md",
    "design": "design/",
    "tasks": "tasks.md",
    "qaTasks": "qa-tasks.md",
    "purpose": "Make the agent's understanding, design, plan, implementation tasks, testing, QA, and optional developer decisions visible and traceable."
  }
}
